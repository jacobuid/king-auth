# Production: set in DirectAdmin's Node.js environment variables.
NODE_ENV=production
AUTH_BASE_URL=https://kingauth.app
DB_HOST=localhost
DB_PORT=3306
DB_NAME=xdjzyshp_king-autk
DB_USER=xdjzyshp_king-autk
DB_PASSWORD=
# Deployment generates a persistent .runtime-secret if this is not set.
BETTER_AUTH_SECRET=
# Comma-separated permanent user IDs allowed to register websites.
KING_AUTH_ADMIN_IDS=

# Configure SMTP OR a sendmail executable; neither is enabled implicitly.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=King Auth <noreply@kingauth.app>
SENDMAIL_PATH=

# Optional SMS delivery. Phone authentication is disabled until configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
