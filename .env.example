# Production: use private .env files or host environment variables; never commit secrets.
NODE_ENV=production
AUTH_BASE_URL=https://kingauth.app
DB_HOST=localhost
DB_PORT=3306
DB_NAME=xdjzyshp_king-autk
DB_USER=xdjzyshp_kingapp
DB_PASSWORD=
# Alternatively store just the password in .database-password (mode 600).
# Deployment generates a persistent .runtime-secret if this is not set.
BETTER_AUTH_SECRET=
# Comma-separated permanent user IDs allowed to register websites.
KING_AUTH_ADMIN_IDS=
# Owner approval is always required in production. For isolated development only:
# SIGNUP_APPROVAL_REQUIRED=false

# Configure SMTP OR a sendmail executable; neither is enabled implicitly.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=King Auth <noreply@kingauth.app>
SENDMAIL_PATH=

# Optional SMS delivery. Phone authentication is disabled until configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
